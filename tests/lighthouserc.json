{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "url": [
        "http://localhost/index.html",
        "http://localhost/posts/hello-world/index.html",
        "http://localhost/about/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --use-angle=swiftshader --enable-unsafe-swiftshader --ignore-gpu-blocklist"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.6 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 700000 }],
        "resource-summary:stylesheet:size": ["warn", { "maxNumericValue": 60000 }]
      }
    }
  }
}
